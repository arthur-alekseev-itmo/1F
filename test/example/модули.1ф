пусть () =
  Список.диапазон 100 200
  |> Список.развернуть
  |> Список.карта (лямбда число -> число - 100)
  |> Список.фильтр (лямбда число -> число % 10 = 0)
  |> Список.в_строку строка_из_числа
  |> напечатай