пусть (|>) икс ф = ф икс

модуль Список = структура
  пусть рек карта ф список =
    сопоставить список с
    | [] -> []
    | э :: хв -> ф э :: карта ф хв

  пусть рек фильтр ф список =
    сопоставить список с
    | [] -> []
    | э :: хв когда ф э -> э :: фильтр ф хв
    | _ :: хв -> фильтр ф хв

  пусть рек длина список =
    сопоставить список с
    | [] -> 0
    | _ :: хв -> 1 + длина хв

  пусть развернуть список =
    пусть рек помощь аккум список =
      сопоставить список с
      | [] -> аккум
      | э :: хв -> помощь (э :: аккум) хв
    в помощь [] список

  пусть рек свернуть_лево свертка начало список =
    сопоставить список с
    | [] -> начало
    | элем :: хв -> свернуть_лево свертка (свертка начало элем) хв

  пусть перевернуть =
    пусть рек помощь аккум список =
      сопоставить список с
      | [] -> аккум
      | элем :: хв -> помощь (хв :: аккум) хв
    в помощь []
  
  пусть в_строку элем_в_строку список =
    пусть рек помощь список =
      сопоставить список с
      | [] -> "]"
      | элем :: [] -> элем_в_строку элем ^ "]"
      | элем :: хв -> элем_в_строку элем ^ "; " ^ помощь хв
    в "[" ^ помощь список
  
  пусть рек отсортировать список =
    сопоставить список с
    | [] -> []
    | пивот :: остаток ->
      пусть до_пивота = фильтр ((>) пивот) остаток в
      пусть после_пивота = фильтр ((<) пивот) остаток в
      пусть пивоты = пивот :: фильтр ((=) пивот) остаток в
      отсортировать до_пивота @ пивоты @ отсортировать после_пивота
  
  пусть рек диапазон начало финал =
    если начало > финал то []
    иначе начало :: диапазон (начало + 1) финал
конец

