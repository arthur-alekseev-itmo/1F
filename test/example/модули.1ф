  [1; 5; 15; 20; 3; 8; 16; 11; 7; 22; 6; 3]
  |> Список.фильтр ((>) 10)
  |> Список.карта ((*) 5)
  |> Список.свернуть_лево (+) 1
  |> строка_из_числа
  |> напечатай

