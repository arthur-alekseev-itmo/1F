тип Рез<а, б> = Ок из а | Фейл из б

пусть (>>=) (м: Рез<а, о>) (ф: а -> Рез<б, о>): Рез<б, о> =
  сопоставить м с
  | Ок(рез) -> ф рез
  | Фейл(сообщ) -> Фейл(сообщ)

пусть плюс (икс: инт): инт = икс + 1
пусть плюсм (икс: инт): Рез<инт, строка> = Ок(икс + 1)

пусть _: Рез<скиб, строка> = Ок(10) >>= плюсм >>= (лямбда (икс: инт) -> 
  пусть строка = строка_из_числа икс в
  пусть () = напечатай строка в
  Ок()
)
