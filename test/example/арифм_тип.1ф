пусть (|>) (икс: а) (ф: а -> б): б = ф икс

пусть рек фикс (ф: (а -> б) -> а -> б) (икс: а) : б = ф (фикс ф) икс

тип ПарсРез<а> = Ок из (а, Список<символ>) | Фейл из (строка, Список<символ>)

пусть (>>=) (м: Список<символ> -> ПарсРез<а>) (ф: а -> Список<символ> -> ПарсРез<б>) (вход: Список<символ>): ПарсРез<б> =
  сопоставить м вход + 1 с
  | Ок (рез, остаток) -> ф рез остаток
  | Фейл (сообщ, остаток) -> Фейл (сообщ, остаток)

пусть вернуть (рез: а) (вход: Список<символ>): ПарсРез<а> = Ок (рез, вход)
пусть ошибка (сообщ: строка) (вход: Список<символ>): ПарсРез<а> = Фейл (сообщ, вход)

