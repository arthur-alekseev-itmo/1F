тип Выражение =
  | Число из инт
  | Сложить из (Выражение, Выражение) 
  | Умножить из (Выражение, Выражение)
  | Делить из (Выражение, Выражение)
  | Вычесть из (Выражение, Выражение)


пусть (|>) (икс: а) (ф: а -> б): б = ф икс

алиас Вход = Список<символ> 
тип ПарсРез<а> = Ок из (а, Вход) | Фейл из (строка, Вход) 
алиас Парсер<а> = Вход -> ПарсРез<а> 

пусть (>>=) (м: Парсер<а>) (ф: а -> Парсер<б>) (вход: Вход): ПарсРез<б> =
  сопоставить м вход с
  | Ок (рез, остаток) -> ф рез остаток
  | Фейл (сообщ, остаток) -> Фейл (сообщ, остаток)

пусть вернуть (рез: а) (вход: Вход): ПарсРез<а> = Ок (рез, вход)
пусть ошибка (сообщ: строка) (вход: Вход): ПарсРез<а> = Фейл (сообщ, вход)

пусть (<|>) (п1: Парсер<а>) (п2: Парсер<а>) (вход: Вход): ПарсРез<а> =
  сопоставить п1 вход с
  | Фейл _ -> п2 вход
  | другое -> другое

пусть (*>) (п1: Парсер<а>) (п2: Парсер<б>): Парсер<б> = п1 >>= (лямбда (_: а) -> п2)
пусть (<*) (п1: Парсер<б>) (п2: Парсер<а>): Парсер<б> = п1 >>= (лямбда (рез: б) -> п2 *> вернуть рез)
пусть (<<) (п1: Парсер<б>) (п2: Парсер<а>): Парсер<б> = п1 <* п2 <|> п1
пусть (>>) (п1: Парсер<а>) (п2: Парсер<б>): Парсер<б> = п1 *> п2 <|> п2

пусть рек много (п: Парсер<а>) : Парсер< Список<а> > = несколько п <|> вернуть []

и несколько (п: Парсер<а>) : Парсер< Список<а> > =
  п >>= лямбда (голова : а) ->
  много п >>= лямбда (хвост : Список<а>) ->
  вернуть (голова :: хвост)

пусть п_символ (предикат: символ -> бул) (вход: Вход): ПарсРез<символ> =
  сопоставить вход с
  | [] -> ошибка "Конец файла" []
  | г :: х когда предикат г -> вернуть г х
  | _ -> ошибка "Символ не удовлетворяет предикату" []

пусть рек элемент (список: Список<а>) (элем: а): бул =
  сопоставить список с
  | [] -> нет
  | г :: х когда г = элем -> да
  | г :: х -> элемент х элем

пусть цифры: Список<символ> = 
  список_из_строки "0123456789"

пусть символ_цифра: символ -> бул =
  элемент цифры

пусть пробелы : Парсер< Список<символ> > = много (п_символ ((=) ' '))

пусть убрать_пробелы: Парсер<а> -> Парсер<а> = (>>) пробелы

пусть пп_число: Парсер<Выражение> =
  несколько (п_символ символ_цифра) >>= лямбда (цифры: Список<символ>) ->
  пусть рез = строка_из_списка цифры |> число_из_строки |> Число в
  вернуть рез

пусть п_число: Парсер<Выражение> = убрать_пробелы пп_число

пусть поднять2 (ф: а -> б -> д) (а: Парсер<а>) (б: Парсер<б>): Парсер<д> =
  а >>= лямбда (аа: а) ->
  б >>= лямбда (бб: б) ->
  вернуть (ф аа бб)

пусть цепь_лев (выраж: Парсер<а>) (оп: Парсер< а -> а -> Парсер<а> >): Парсер<а> =
  пусть рек идти (аккум: а) =
    (поднять2 (лямбда (ф: а -> а -> Парсер<а>) (икс: а) -> ф аккум икс) оп выраж >>= идти)
    <|> вернуть аккум
  в выраж >>= идти

пусть равно_аст (сим: символ): бул =
  пусть рез = сим = '*' в
  пусть () = дебаг сим в
  пусть () = дебаг рез в
  рез

пусть п_умножить: Парсер<Выражение -> Выражение -> Выражение> =
  (пробелы >> п_символ (равно_аст)) *> 
  вернуть (лямбда (а: Выражение) (б: Выражение) -> Умножить (а, б))

пусть п_сложить: Парсер<Выражение -> Выражение -> Выражение> =
  (пробелы >> п_символ ((=) '+')) *> 
  вернуть (лямбда (а: Выражение) (б: Выражение) -> Сложить (а, б))

пусть п_делить: Парсер<Выражение -> Выражение -> Выражение> =
  (пробелы >> п_символ ((=) '/')) *> 
  вернуть (лямбда (а: Выражение) (б: Выражение) -> Делить (а, б))

пусть п_убавить: Парсер<Выражение -> Выражение -> Выражение> =
  (пробелы >> п_символ ((=) '-')) *> 
  вернуть (лямбда (а: Выражение) (б: Выражение) -> Вычесть (б, а))

пусть в_скобках (п: Парсер<а>): Парсер<а> =
  (пробелы >> п_символ ((=) '(')) *>
  (пробелы >> п) <*
  (пробелы >> п_символ ((=) ')'))

пусть рек п_выраж: Парсер<Выражение> =
  пусть множитель = п_число <|> (в_скобках п_выраж) в
  пусть слагаемое = цепь_лев множитель (п_умножить) в
  цепь_лев слагаемое (п_сложить <|> п_убавить)

пусть рек вычислить (выраж: Выражение): инт =
  сопоставить выраж с
  | Число икс -> икс
  | Сложить (а, б) -> вычислить а + вычислить б
  | Вычесть (а, б) -> вычислить а - вычислить б
  | Умножить (а, б) -> вычислить а * вычислить б
  | Делить (а, б) -> вычислить а / вычислить б

пусть мап_парсрез (ф: а -> б) (рез: ПарсРез<а>): ПарсРез<б> =
  сопоставить рез с
  | Ок (рез, остаток) -> Ок (ф рез, остаток)
  | другое -> другое

пусть (): скиб =
  пусть вход = список_из_строки "3*1" в
  п_выраж вход
  |> мап_парсрез вычислить
  |> дебаг
