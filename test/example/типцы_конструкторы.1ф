тип Мб<а> = Чтото из а | Ничего

пусть икс : Мб<инт> = Чтото 3

пусть игрек : Мб<а> = Ничего

пусть айди_конкретное (а: Мб<а>) : Мб<а> = а

пусть тест1 : Мб<а> = айди_конкретное игрек
пусть тест2 : Мб<инт> = айди_конкретное икс

пусть мб_достать (дефолт: а) (знач: Мб<а>) : а =
  сопоставить знач с
  | Чтото икс -> икс
  | Ничего -> дефолт

пусть тест3 : инт = мб_достать 5 икс
пусть тест4 : инт = мб_достать 4 игрек