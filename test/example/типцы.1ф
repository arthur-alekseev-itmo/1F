
пусть рек фикс (ф : (а -> б) -> а -> б) (икс : а) : б = ф (фикс ф) икс
пусть факториал_откр (ф: инт -> инт) (икс: инт) : инт =
  если икс > 1 то ф (икс - 1) * икс
  иначе 1

пусть факториал : инт -> инт = фикс факториал_откр
пусть (|>) (икс : а) (ф : а -> б) : б = ф икс
пусть () : скиб = факториал 10 |> строка_из_числа |> напечатай

пусть рек чет (икс : инт) : бул =
  сопоставить икс с
  | 0 -> да
  | _ -> не (чет (икс - 1))

пусть строка_из_була (бул: бул): строка =
  сопоставить бул с
  | да -> "да"
  | нет -> "нет"

пусть рек чет2 (икс : инт) : бул =
  если икс = 0 то да
  иначе чет2 (икс - 1)

и нечет2 (икс: инт) : бул =
  если икс = 0 то нет
  иначе чет2 (икс - 1)

пусть () : скиб = чет 2 |> строка_из_була |> напечатай
