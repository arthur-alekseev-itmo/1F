модуль Список = структура
  пусть рек карта ф список =
    сопоставить список с
    | [] -> []
    | э :: хв -> ф э :: карта ф хв

  пусть рек фильтр ф список =
    сопоставить список с
    | [] -> []
    | э :: хв когда ф э -> э :: фильтр ф хв
    | _ :: хв -> фильтр ф хв

  пусть рек длина список =
    сопоставить список с
    | [] -> 0
    | _ :: хв -> 1 + длина хв

  пусть развернуть список =
    пусть рек помощь аккум список =
      сопоставить список с
      | [] -> аккум
      | э :: хв -> помощь (э :: аккум) хв
    в помощь [] список

  пусть рек свернуть_лево свертка начало список =
    сопоставить список с
    | [] -> начало
    | элем :: хв -> свернуть_лево свертка (свертка начало элем) хв

  пусть перевернуть =
    пусть рек помощь аккум список =
      сопоставить список с
      | [] -> аккум
      | элем :: хв -> помощь (элем :: аккум) хв
    в помощь []
  
  пусть в_строку элем_в_строку список =
    пусть рек помощь список =
      сопоставить список с
      | [] -> "]"
      | элем :: [] -> элем_в_строку элем ^ "]"
      | элем :: хв -> элем_в_строку элем ^ "; " ^ помощь хв
    в "[" ^ помощь список
  
  пусть рек отсортировать список =
    сопоставить список с
    | [] -> []
    | пивот :: остаток ->
      пусть до_пивота = фильтр ((>) пивот) остаток в
      пусть после_пивота = фильтр ((<) пивот) остаток в
      пусть пивоты = пивот :: фильтр ((=) пивот) остаток в
      отсортировать до_пивота @ пивоты @ отсортировать после_пивота
  
  пусть рек диапазон начало финал =
    если начало > финал то []
    иначе начало :: диапазон (начало + 1) финал

  пусть рек имеет список элем =
    сопоставить список с
    | [] -> нет
    | х :: _ когда х = элем -> да
    | _ :: хв -> имеет хв элем
  
  пусть делить_пока условие список =
    пусть помощь аккум список =
      сопоставить список с
      | [] -> (перевернуть аккум, [])
      | г :: хв когда условие г -> помощь (г :: аккум) хв
      | др -> (перевернуть аккум, др)
    в помощь [] список
конец

модуль СписокТаблица = структура
  пусть рек найти таблица ключ =
    сопоставить таблица с
    | (к, з) :: х когда к = ключ -> Чето з
    | [] -> Нич
    | _ :: х -> найти х ключ
конец


модуль Символ = структура
  пусть числа = список_из_строки "1234567890"
  пусть маленькие_буквы = список_из_строки "абвгдеёжзийклмнопрстуфхцчшщьыъэюя"
  пусть большие_буквы = список_из_строки "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЬЫЪЭЮЯ"
  пусть значки = список_из_строки "~!@#$%^&*-=<>/:;"
  пусть пробельные = список_из_строки " \n\t"
  пусть буквы = маленькие_буквы @ большие_буквы

  пусть число символ = Список.имеет числа символ
  пусть большая символ = Список.имеет большие_буквы символ
  пусть маленькая символ = Список.имеет маленькие_буквы символ
  пусть буква символ = Список.имеет буквы символ
  пусть пробельный символ = Список.имеет пробельные символ
  пусть значок символ = Список.имеет значки символ
конец


модуль Лексер = структура
  пусть состояние строка = { позиция = 0; поток = список_из_строки строка; результат = [] }

  пусть ключевые_слова = [
    ("пусть", ТокПусть);
    ("рек", ТокРек);
    ("в", ТокВ);
    ("если", ТокЕсли);
    ("то", ТокТо);
    ("иначе", ТокИначе);
    ("да", ТокБул да);
    ("нет", ТокБул нет)
  ]

  пусть базовый_лекс предикат ктор состояние =
    пусть (символы, остаток) = Список.делить_пока предикат состояние.поток в
    пусть строка = строка_из_списка символы в
    пусть нач = состояние.позиция в
    пусть кон = состояние.позиция + Список.длина символы в
    пусть новое_состояние = {
      состояние с поток = остаток;
      позиция = состояние.позиция + Список.длина символы;
      результат = { токен = ктор строка; позиция = (нач, кон) } :: состояние.результат
    } в лекс_анализ новое_состояние

  пусть лекс_число ст = базовый_лекс Символ.число (лямбда х -> ТокЧисло (число_из_строки х)) ст
  
  пусть лекс_пробелы состояние =
    пусть (символы, остаток) = Список.делить_пока Символ.пробельный состояние.поток в
    пусть новое_состояние = {
      состояние с поток = остаток;
      позиция = состояние.позиция + Список.длина символы
    } в лекс_анализ новое_состояние

  пусть лекс_имя ст =
    пусть токен имя = сопоставить СписокТаблица.найти ключевые_слова имя с
      | Чето ктор -> ктор
      | Нич -> ТокМалИмя имя
    в базовый_лекс Символ.буква токен ст
  
  пусть лекс_оператор ст = базовый_лекс Символ.значок Оператор ст

  пусть побеги = [('n', '\n'); ('t', '\t'); ('\\', '\\'); ('"', '"')]  

  пусть рек лекс_анализ состояние =
    сопоставить состояние.поток с
    | [] -> Список.перевернуть состояние.результат
    | г :: _ когда Символ.число г -> лекс_число состояние
    | г :: _ когда Символ.маленькая г -> лекс_имя состояние
    | г :: _ когда Символ.значок г -> лекс_оператор состояние
    | г :: _ когда Символ.пробельный г -> лекс_пробелы состояние
    | г :: хв когда г = '"' -> лекс_строка состояние (лямбда икс -> икс) хв

конец

