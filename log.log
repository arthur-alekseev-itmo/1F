clet |> (икс: а) (ф: а -> б) = ф икс
clet >>= (м: Парсер<а>) (ф: а -> Парсер<б>) (вход: Вход<>) = сопоставить м вход с| Ок (рез, остаток) -> ф рез остаток | Фейл (сообщ, остаток) -> Фейл (сообщ, остаток)
clet вернуть (рез: а) (вход: Вход<>) = Ок (рез, вход)
clet ошибка (сообщ: строка) (вход: Вход<>) = Фейл (сообщ, вход)
clet <|> (п1: Парсер<а>) (п2: Парсер<а>) (вход: Вход<>) = сопоставить п1 вход с| Фейл _ -> п2 вход | другое -> другое
clet lam$1 (п2: ?) (_: а) = п2
clet *> (п1: Парсер<а>) (п2: Парсер<б>) = п1 >>= (lam$1 п2)
clet lam$2 (п2: ?) (рез: ж) = п2 *> (вернуть рез)
clet <* (п1: Парсер<ж>) (п2: Парсер<а>) = п1 >>= (lam$2 п2)
clet << (п1: Парсер<б>) (п2: Парсер<а>) = (п1 <* п2) <|> п1
clet >> (п1: Парсер<а>) (п2: Парсер<б>) = (п1 *> п2) <|> п2
clet много (п: Парсер<а>) = (несколько п) <|> (вернуть [])
clet lam$3 (п: ?) (голова: а) = (много п) >>= (lam$4 голова)
clet lam$4 (голова: ?) (хвост: Список<а>) = вернуть (голова :: хвост)
clet несколько (п: Парсер<а>) = п >>= (lam$3 п)
clet п_символ (предикат: символ -> бул) (вход: Вход<>) = сопоставить вход с| [] -> ошибка "Конец файла" [] | г :: х когда предикат г -> вернуть г х | _ -> ошибка "Символ не удовлетворяет предикату" []
clet элемент (список: Список<а>) (элем: а) = сопоставить список с| [] -> false | г :: х когда г = элем -> true | г :: х -> элемент х элем
clet цифры  = список_из_строки "0123456789"
clet символ_цифра  = элемент цифры
clet пробелы  = много (п_символ (' ' =))
clet убрать_пробелы  = пробелы >>
clet lam$5 (цифры: Список<символ>) = пусть рез = ((строка_из_списка цифры) |> число_из_строки) |> Число в вернуть рез
clet пп_число  = (несколько (п_символ символ_цифра)) >>= lam$5
clet п_число  = убрать_пробелы пп_число
clet lam$6 (б: ?) (ф: ?) (аа: а) = б >>= (lam$7 аа ф)
clet lam$7 (аа: ?) (ф: ?) (бб: б) = вернуть (ф аа бб)
clet поднять2 (ф: а -> б -> д) (а: Парсер<а>) (б: Парсер<б>) = а >>= (lam$6 б ф)
clet lam$8 (выраж: ?) (идти: ?) (оп: ?) (аккум: а) = ((поднять2 (lam$9 аккум) оп выраж) >>= идти) <|> (вернуть аккум)
clet lam$9 (аккум: ?) (ф: а -> а -> Парсер<а>) (икс: а) = ф аккум икс
clet цепь_лев (выраж: Парсер<а>) (оп: Парсер<а -> а -> Парсер<а>>) = пусть рек идти = lam$8 выраж идти оп в выраж >>= идти
clet равно_аст (сим: символ) = пусть рез = сим = '*' в пусть () = дебаг сим в пусть () = дебаг рез в рез
clet lam$10 (а: Выражение<>) (б: Выражение<>) = (Умножить (а, б)) |> вернуть
clet п_умножить  = (пробелы >> (п_символ равно_аст)) *> (вернуть lam$10)
clet lam$11 (а: Выражение<>) (б: Выражение<>) = (Сложить (а, б)) |> вернуть
clet п_сложить  = (пробелы >> (п_символ ('+' =))) *> (вернуть lam$11)
clet lam$12 (а: Выражение<>) (б: Выражение<>) = (Делить (а, б)) |> вернуть
clet п_делить  = (пробелы >> (п_символ ('/' =))) *> (вернуть lam$12)
clet lam$13 (а: Выражение<>) (б: Выражение<>) = (Вычесть (б, а)) |> вернуть
clet п_убавить  = (пробелы >> (п_символ ('-' =))) *> (вернуть lam$13)
clet скобкал  = пробелы >> (п_символ ('(' =))
clet скобкап  = пробелы >> (п_символ (')' =))
clet в_скобках (п: Парсер<а>) = (скобкал *> п) <* скобкап
clet п_выраж  = пусть множитель = п_число <|> (в_скобках п_выраж) в пусть слагаемое = цепь_лев множитель п_умножить в цепь_лев слагаемое (п_сложить <|> п_убавить)
clet вычислить (выраж: Выражение<>) = сопоставить выраж с| Число икс -> икс | Сложить (а, б) -> (вычислить а) + (вычислить б) | Вычесть (а, б) -> (вычислить а) - (вычислить б) | Умножить (а, б) -> (вычислить а) * (вычислить б) | Делить (а, б) -> (вычислить а) / (вычислить б)
clet мап_парсрез (ф: а -> б) (рез: ПарсРез<а>) = сопоставить рез с| Ок (рез, остаток) -> Ок (ф рез, остаток) | другое -> другое
clet ()  = пусть вход = список_из_строки "3*1+5-2" в (п_выраж вход) |> дебаг
